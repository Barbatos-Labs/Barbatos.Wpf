<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Barbatos.Wpf.Aquarius</PackageId>
    <TargetFrameworks>net10.0-windows;net9.0-windows;net8.0-windows</TargetFrameworks>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <UseWPF>true</UseWPF>
    <!-- Full override, not an append to the shared $(CommonTags) - that shared value bakes in
         Core-specific words (maui, hosting, essentials, notifications, ...) that don't describe
         Aquarius and would mislead NuGet search. -->
    <CommonTags>dotnet;wpf;windows;desktop;presentation;compositionapi;reactivity;lifecycle;mvvm;directives;teleport;animation;xaml</CommonTags>
    <Description>Reactive state and composition-style bindings for WPF - Ref/Computed/Watch, lifecycle hooks, two-way binding, conditional rendering, and event-wiring directives, custom directives, Teleport, Transition, Provide/Inject, Suspense - built directly on CommunityToolkit.Mvvm.</Description>
    <RootNamespace>Barbatos.Wpf.Aquarius</RootNamespace>
    <PackageIconSourceFile>aquarius-logo.png</PackageIconSourceFile>
    <!-- WPF does not support trimming/AOT, so the configuration-binding trim warnings do not apply.
         IL2075 additionally covers Directives.Event's own use of reflection (Type.GetEvent) to wire
         up an arbitrary named event, which is inherently dynamic by design (see its XML docs).
         IL2067 covers Setup's Activator.CreateInstance(Type)/Assembly.GetType(string)
         calls, similarly inherently dynamic (see its XML docs). -->
    <NoWarn>$(NoWarn);IL2026;IL3050;IL2075;IL2067</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <!-- Abstractions only, never a container implementation: this package offers
         services.AddAquarius()/provider.UseAquarius() so an app can configure Aquarius through
         the same DI it configures everything else with, but it never builds or owns a container.
         Microsoft.Extensions.Options is what backs AquariusOptions/IOptions<T>. -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
  </ItemGroup>

</Project>
