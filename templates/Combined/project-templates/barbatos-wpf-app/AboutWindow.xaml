<Window x:Class="BarbatosWpfApp.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About" Height="180" Width="360"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <StackPanel Margin="16">
        <TextBlock Text="BarbatosWpfApp" FontWeight="SemiBold" FontSize="16" />
        <TextBlock Margin="0,8,0,0" TextWrapping="Wrap"
                   Text="Shown through IDialogService - owner resolved automatically, and a second click activates this instance instead of opening a duplicate." />
    </StackPanel>
</Window>
