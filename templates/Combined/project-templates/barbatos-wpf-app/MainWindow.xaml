<Window x:Class="BarbatosWpfApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
<!--#if (AquariusEffective) -->
        xmlns:aq="http://schemas.barbatos.co/aquarius/2026/xaml"
        xmlns:local="clr-namespace:BarbatosWpfApp"
<!--#endif -->
<!--#if (IncludeI18n) -->
        xmlns:i18n="http://schemas.barbatos.co/i18n/2026/xaml"
<!--#endif -->
<!--#if (IncludeAquariusRouter) -->
        xmlns:aqr="http://schemas.barbatos.co/aquariusrouter/2026/xaml"
<!--#endif -->
<!--#if (AquariusEffective) -->
        aq:Setup.ViewModel="{x:Type local:MainViewModel}"
<!--#endif -->
        Title="BarbatosWpfApp" Height="450" Width="800">
<!--#if (IncludeAquariusRouter) -->
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" HorizontalAlignment="Center" Margin="16,16,16,0">
            <!-- A literal path, and the same kind of target expressed by route *name*:
                 {aqr:RouteTo} builds the RouteLocationRaw from XAML, so a nav bar never has to
                 hardcode where a named route currently lives (add Params='id=42' for a
                 parameterized one). -->
            <Button Content="Home" aqr:RouterLink.To="/" Padding="12,4" Margin="0,0,8,0" />
            <Button Content="About (routed)" aqr:RouterLink.To="{aqr:RouteTo Name=about}" Padding="12,4" />
<!--#if (IncludeValee) -->
            <Button Content="Sign up" aqr:RouterLink.To="{aqr:RouteTo Name=signup}" Padding="12,4" Margin="8,0,0,0" />
<!--#endif -->
        </StackPanel>
        <!-- In-app route search: RouteSearchIndex queries the Search entries declared in
             AppRoutes.cs, so a user can jump straight to a feature instead of walking the menu.
             AquariusRouter ships the query engine only - this list is ordinary WPF, deliberately,
             so it can look like the rest of your app rather than like the library. -->
        <StackPanel DockPanel.Dock="Top" Width="280" HorizontalAlignment="Center" Margin="16,12,16,0">
            <TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" Padding="4" />
            <ListBox ItemsSource="{Binding SearchResults}" MaxHeight="120" Margin="0,4,0,0">
                <ListBox.Style>
                    <Style TargetType="ListBox">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasSearchResults}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ListBox.Style>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <!-- Title, not Entry.Title: the former is what RouteSearchIndex.TextResolver
                             produced, so a localized app shows translated text, not a resource key. -->
                        <Button Content="{Binding Title}" HorizontalContentAlignment="Left" Padding="6,3"
                                Background="Transparent" BorderThickness="0" Cursor="Hand"
                                Command="{Binding DataContext.GoToSearchResultCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                CommandParameter="{Binding}" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </StackPanel>
        <StackPanel DockPanel.Dock="Top" HorizontalAlignment="Center" Margin="16">
<!--#else -->
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
<!--#endif -->
<!--#if (IncludeI18n) -->
        <!-- Barbatos.i18n.Wpf's markup extension - BindArg (not the static Arg) is what makes
             this refresh when SwitchLanguage below changes CurrentCultureName; see
             MainViewModel's own remarks on CurrentCultureName for why that's needed at all. -->
        <TextBlock FontSize="18" Margin="0,0,0,16" TextWrapping="Wrap" MaxWidth="400" TextAlignment="Center"
                   Text="{i18n:StringLocalizer Text='Greeting', BindArg={Binding CurrentCultureName}}" />

<!--#endif -->
<!--#if (AquariusEffective) -->
        <TextBlock Text="{Binding Count.Value}" FontSize="32" HorizontalAlignment="Center" />
        <Button Content="Count" Command="{Binding IncrementCommand}" Padding="20,8" Margin="0,16,0,0" HorizontalAlignment="Center" />

<!--#endif -->
<!--#if (IncludeI18n) -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,24,0,0">
            <Button Content="English" Command="{Binding SwitchLanguageCommand}" CommandParameter="en-US" Padding="12,4" Margin="0,0,8,0" />
            <Button Content="Tiếng Việt" Command="{Binding SwitchLanguageCommand}" CommandParameter="vi-VN" Padding="12,4" />
        </StackPanel>
<!--#endif -->
<!--#if (IncludeDialogs) -->
        <Button Content="About" Command="{Binding ShowAboutCommand}" Padding="12,4" Margin="16,16,16,0" HorizontalAlignment="Center" />
<!--#endif -->
<!--#if (IncludeRunOnStartup) -->
        <!-- Nothing registers the app with Windows startup until this is ticked - see
             MainViewModel.RunOnStartupEnabled for why. -->
        <CheckBox Content="Launch when Windows starts" IsChecked="{Binding RunOnStartupEnabled}" Margin="0,16,0,0" HorizontalAlignment="Center" />
<!--#endif -->
<!--#if (IncludeValee && !IncludeAquariusRouter) -->
        <!-- With AquariusRouter also enabled, this same View is reached as the "/signup" route
             instead of being hosted inline here - see AppRoutes.cs. Either way its ViewModel is
             found by its own aq:Setup.Enable, not by anything set here. -->
        <local:SignUpView />
<!--#endif -->
<!--#if (IncludeAquariusRouter) -->
        </StackPanel>
        <aqr:RouterView Margin="16" />
    </DockPanel>
<!--#else -->
    </StackPanel>
<!--#endif -->
</Window>
