<UserControl x:Class="BarbatosWpfApp.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Note what is *not* here: no aq:Setup.Enable, no aq:Setup.ViewModel. AppRoutes.cs pairs
         this View with AboutViewModel from the route table instead, which is why {Binding Note}
         below resolves - see HomeView.xaml for the more usual, convention-based wiring. -->
    <StackPanel Margin="24">
        <TextBlock Text="About" FontSize="24" FontWeight="Bold" />
        <TextBlock Margin="0,8,0,0" TextWrapping="Wrap"
                   Text="A second route, rendered through the same RouterView outlet as Home - navigated to via aqr:RouterLink.To, not a second window." />
        <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Foreground="Gray" Text="{Binding Note}" />
    </StackPanel>
</UserControl>
