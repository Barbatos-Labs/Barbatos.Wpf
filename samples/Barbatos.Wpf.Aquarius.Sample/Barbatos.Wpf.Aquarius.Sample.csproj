<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <IsPackable>false</IsPackable>
    <Product>Barbatos.Wpf.Aquarius Sample</Product>
    <Company>Barbatos Labs</Company>
    <Version>1.0.0</Version>
    <!-- See Barbatos.Wpf.Core.Sample.csproj: without these the sample inherits the library's
         AssemblyVersion pinned in Directory.Build.props, and AppInfo.Version and File Explorer
         report that instead of its own. -->
    <AssemblyVersion>$(Version)</AssemblyVersion>
    <FileVersion>$(Version)</FileVersion>
    <Copyright>Copyright (c) 2026 Barbatos Labs</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Barbatos.Wpf.Aquarius\Barbatos.Wpf.Aquarius.csproj" />
    <!-- Core and Aquarius are otherwise fully independent packages - this reference exists only
         so this sample can demonstrate combining Barbatos.Wpf.Apsu (Core's Pinia-style store
         module) with Aquarius's own Composition API, see ApsuInteropDemoView. -->
    <ProjectReference Include="..\..\src\Barbatos.Wpf.Core\Barbatos.Wpf.Core.csproj" />
    <!-- A component shared with Barbatos.Wpf.AquariusRouter.Sample (see InfoCardView) - both
         samples reference this shared library directly, never each other. -->
    <ProjectReference Include="..\Barbatos.Wpf.Samples.Shared\Barbatos.Wpf.Samples.Shared.csproj" />
  </ItemGroup>

</Project>
