<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <IsPackable>false</IsPackable>
    <Product>Barbatos.Wpf Samples Shared</Product>
    <Company>Barbatos Labs</Company>
    <Version>1.0.0</Version>
    <Copyright>Copyright (c) 2026 Barbatos Labs</Copyright>
  </PropertyGroup>

  <!--
    No <OutputType> - a plain library (DLL), not an EXE. This is what a real shared component
    library looks like: multiple sample apps ProjectReference *this*, never each other directly.
    Referencing one sample EXE from a different sample EXE would drag that other sample's own
    App/WpfProgram/DI setup along as a transitive dependency, and wire together two apps that are
    each meant to demonstrate one package in isolation - this project exists specifically so that
    never has to happen.
  -->

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Barbatos.Wpf.Aquarius\Barbatos.Wpf.Aquarius.csproj" />
  </ItemGroup>

</Project>
