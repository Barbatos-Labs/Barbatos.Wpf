<Window x:Class="Barbatos.Wpf.AquariusRouter.Sample.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:aqr="http://schemas.barbatos.co/aquariusrouter/2026/xaml"
        xmlns:services="clr-namespace:Barbatos.Wpf.AquariusRouter.Sample.Services"
        Title="Barbatos.Wpf.AquariusRouter Sample" Height="600" Width="900">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <!-- Hides every nav RouterLink while logged out; a premium-gated one then stays visible
             but disabled once logged in on the free plan - see PremiumAccessConverter below and
             AuthState's own remarks. -->
        <services:LoggedInVisibilityConverter x:Key="LoggedInVisibility" />
        <services:LoggedOutVisibilityConverter x:Key="LoggedOutVisibility" />
        <services:PremiumAccessConverter x:Key="PremiumAccess" />
        <Style x:Key="NavLink" TargetType="Button">
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="Padding" Value="6,3" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Visibility" Value="{Binding AuthState.IsLoggedIn, Converter={StaticResource LoggedInVisibility}}" />
            <Style.Triggers>
                <!-- The native-WPF mapping of Vue Router's linkActiveClass: a plain bindable bool
                     consumed via an ordinary DataTrigger instead of a CSS class name. -->
                <DataTrigger Binding="{Binding (aqr:RouterLink.IsActive), RelativeSource={RelativeSource Self}}" Value="True">
                    <Setter Property="FontWeight" Value="Bold" />
                    <Setter Property="Foreground" Value="#2050C0" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- The exact inverse of NavLink's Visibility - the one nav entry that must stay reachable
             precisely when every other RouterLink above is hidden, so logging in is actually
             possible instead of a dead end. -->
        <Style x:Key="NavLinkLoggedOut" TargetType="Button" BasedOn="{StaticResource NavLink}">
            <Setter Property="Visibility" Value="{Binding AuthState.IsLoggedIn, Converter={StaticResource LoggedOutVisibility}}" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="12" VerticalAlignment="Center">
            <!-- The one link every other NavLink's Visibility rule can't show while logged out -
                 without this, there would be no way back to /login at all. -->
            <Button Content="Log In" Style="{StaticResource NavLinkLoggedOut}" aqr:RouterLink.To="/login" />
            <Button Content="Home" Style="{StaticResource NavLink}" aqr:RouterLink.To="/" />
            <Button Content="About" Style="{StaticResource NavLink}" aqr:RouterLink.To="/about" />
            <!-- InfoCardView is defined in Barbatos.Wpf.Samples.Shared and reused unmodified in
                 Barbatos.Wpf.Aquarius.Sample too - see AppRoutes.cs's own remarks. -->
            <Button Content="Shared component" Style="{StaticResource NavLink}" aqr:RouterLink.To="/shared-demo" />
            <!-- A View here whose ViewModel lives in Barbatos.Wpf.Samples.Shared under a different
                 namespace and a non-conventional name - see AppRoutes.cs's "/accounts/:id". -->
            <Button Content="Cross-assembly VM" Style="{StaticResource NavLink}"
                    aqr:RouterLink.To="{aqr:RouteTo Name=account-summary, Params='id=SA-1234'}" />
            <!-- The same target written two ways: a literal path, and the {aqr:RouteTo} markup
                 extension resolving the "user" route BY NAME - so this link keeps working even if
                 that route's path is later changed in AppRoutes.cs. -->
            <Button Content="User 1" Style="{StaticResource NavLink}" aqr:RouterLink.To="/users/1" />
            <Button Content="User 2" Style="{StaticResource NavLink}" aqr:RouterLink.To="{aqr:RouteTo Name=user, Params='id=2'}" />
            <Button Content="Dashboard" Style="{StaticResource NavLink}" aqr:RouterLink.To="/dashboard" />
            <Button Content="Preferences" Style="{StaticResource NavLink}" aqr:RouterLink.To="/preferences" />
            <!-- The one premium-gated link (see AppRoutes' "/settings" Meta) - stays visible once
                 logged in (inherited from the NavLink style above) but only enabled on the
                 premium plan. Toggle it from Dashboard's "Premium plan" checkbox. -->
            <Button Content="Settings" Style="{StaticResource NavLink}" aqr:RouterLink.To="/settings">
                <Button.IsEnabled>
                    <MultiBinding Converter="{StaticResource PremiumAccess}">
                        <Binding Path="AuthState.IsLoggedIn" />
                        <Binding Path="AuthState.IsPremium" />
                    </MultiBinding>
                </Button.IsEnabled>
            </Button>
            <Button Content="Admin" Style="{StaticResource NavLink}" aqr:RouterLink.To="/admin" />
            <Button Content="Old Home (redirect)" Style="{StaticResource NavLink}" aqr:RouterLink.To="/old-home" />
            <Button Content="Broken Link (404)" Style="{StaticResource NavLink}" aqr:RouterLink.To="/nonexistent/path" />
            <TextBlock Margin="20,0,0,0" VerticalAlignment="Center" FontStyle="Italic"
                       Text="{Binding AuthState.IsLoggedIn, StringFormat='Logged in: {0}'}" />
            <Button Content="Log Out" Style="{StaticResource NavLink}" Margin="12,0,0,0"
                    Command="{Binding AuthState.LogOutCommand}" />
            <!-- Flipped around the awaited delay inside the global BeforeResolve guard - see
                 MainViewModel.IsNavigating / AppNavigationGuards.Register. -->
            <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" FontWeight="Bold" Foreground="#C05000"
                       Text="Resolving..." Visibility="{Binding IsNavigating, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>

        <!-- The in-app-search demo: a plain TextBox + results ListBox, not a library-provided
             control - RouteSearchIndex is just the query/ranking engine (see its own remarks for
             why). Try "about", "security", or the Vietnamese-diacritic-insensitive "doi mat khau" -
             see AppRoutes.cs's own remarks for the full set of searchable routes. -->
        <StackPanel DockPanel.Dock="Top" Orientation="Vertical" Margin="12,0,12,12" Width="280" HorizontalAlignment="Left">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,6,0" Text="Search:" />
                <TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" />
            </DockPanel>
            <ListBox Margin="0,4,0,0" MaxHeight="140" BorderThickness="1" BorderBrush="#DDDDDD"
                     ItemsSource="{Binding SearchResults}"
                     Visibility="{Binding HasSearchResults, Converter={StaticResource BoolToVisibility}}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <!-- Title, not Entry.Title: the former is what TextResolver produced, so a
                             localized app shows the translated text rather than the resource key. -->
                        <Button Content="{Binding Title}" HorizontalContentAlignment="Left"
                                Background="Transparent" BorderThickness="0" Padding="6,3" Cursor="Hand"
                                Command="{Binding DataContext.GoToSearchResultCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                CommandParameter="{Binding}" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </StackPanel>

        <Border DockPanel.Dock="Top" BorderBrush="#DDDDDD" BorderThickness="0,1,0,0" />

        <!-- The global AfterEach demo: every navigation attempt (including cancelled/aborted/
             duplicated/redirected ones) gets recorded here - see NavigationHistoryLog and
             AppNavigationGuards.Register's AfterEach. -->
        <Border DockPanel.Dock="Right" Width="260" Margin="0,12,12,12" BorderBrush="#DDDDDD" BorderThickness="1,0,0,0" Padding="12,0,0,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Navigation history" FontWeight="Bold" Margin="0,0,0,8" />
                <ListBox ItemsSource="{Binding NavigationHistory.Entries}" BorderThickness="0" Background="Transparent" />
            </DockPanel>
        </Border>

        <DockPanel Margin="12">
            <!-- The named-outlet demo: only /dashboard's route record declares a "sidebar" view,
                 so this stays empty (zero size) on every other route. -->
            <aqr:RouterView OutletName="sidebar" DockPanel.Dock="Right" Margin="12,0,0,0" />
            <aqr:RouterView />
        </DockPanel>
    </DockPanel>
</Window>
