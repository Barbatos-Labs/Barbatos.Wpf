<UserControl x:Class="Barbatos.Wpf.AquariusRouter.Sample.Views.Settings.SettingsSecurityView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:aq="http://schemas.barbatos.co/aquarius/2026/xaml"
             aq:Setup.Enable="True">
    <TextBlock TextWrapping="Wrap">
        <Run FontWeight="Bold" Text="Security" /><LineBreak />
        <Run Text="Reachable directly at /settings/security - this is also the target of the Ctrl+F8 shortcut (see ShortcutRouting.cs), bound as BOTH an in-app KeyBinding and a real OS-level GlobalKeyBinding on the same action - it works whether this window is focused or minimized. Either way, entering this path must construct the WHOLE ancestor chain (the Settings shell AND this leaf) in one guard-pipeline pass, and still redirect to /login first if you weren't logged in." />
    </TextBlock>
</UserControl>
