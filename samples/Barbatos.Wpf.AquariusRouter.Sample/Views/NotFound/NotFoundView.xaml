<UserControl x:Class="Barbatos.Wpf.AquariusRouter.Sample.Views.NotFound.NotFoundView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:aq="http://schemas.barbatos.co/aquarius/2026/xaml"
             aq:Setup.Enable="True">
    <StackPanel Margin="24">
        <TextBlock Text="404 - Not Found" FontSize="24" FontWeight="Bold" />
        <TextBlock Margin="0,8,0,0" TextWrapping="Wrap"
                   Text="Matched via the catch-all route '/:pathMatch(.*)*' - the lowest-ranked route in the table, so every more specific route above always wins first." />
        <TextBlock Margin="0,8,0,0" Text="{Binding RequestedPath}" FontFamily="Consolas" />
    </StackPanel>
</UserControl>
