<UserControl x:Class="Barbatos.Wpf.AquariusRouter.Sample.Views.Users.UserSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:aq="http://schemas.barbatos.co/aquarius/2026/xaml"
             aq:Setup.Enable="True">
    <StackPanel>
        <TextBlock TextWrapping="Wrap">
            <Run Text="Settings for user " /><Run Text="{Binding UserId, Mode=OneWay}" FontWeight="Bold" />
        </TextBlock>
        <TextBox Margin="0,8,0,0" MaxWidth="240" HorizontalAlignment="Left"
                 aq:Directives.Model="{Binding Nickname}" />
        <TextBlock Margin="0,4,0,0" FontStyle="Italic"
                   Text="Try leaving this route via the nav bar with unsaved text below the original value - the leave guard below will ask for confirmation." />
    </StackPanel>
</UserControl>
