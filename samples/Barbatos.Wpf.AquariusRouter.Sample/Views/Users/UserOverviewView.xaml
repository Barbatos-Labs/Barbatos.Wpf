<UserControl x:Class="Barbatos.Wpf.AquariusRouter.Sample.Views.Users.UserOverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:aq="http://schemas.barbatos.co/aquarius/2026/xaml"
             aq:Setup.Enable="True">
    <TextBlock TextWrapping="Wrap">
        <Run Text="Overview for user " /><Run Text="{Binding UserId, Mode=OneWay}" FontWeight="Bold" />
        <LineBreak /><Run Text="This is the empty-path 'index' child of /users/:id - it matches at exactly /users/:id itself, with no extra path segment." />
    </TextBlock>
</UserControl>
