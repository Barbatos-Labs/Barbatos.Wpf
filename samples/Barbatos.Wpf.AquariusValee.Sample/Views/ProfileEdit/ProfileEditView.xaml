<UserControl x:Class="Barbatos.Wpf.AquariusValee.Sample.Views.ProfileEdit.ProfileEditView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:aqv="http://schemas.barbatos.co/aquariusvalee/2026/xaml"
             xmlns:i18n="http://schemas.barbatos.co/i18n/2026/xaml">
    <UserControl.Resources>
        <i18n:LocalizeConverter x:Key="LocalizeConverter" />
    </UserControl.Resources>
    <StackPanel aqv:Valee.Form="{Binding ProfileForm}" Margin="24" MaxWidth="420" HorizontalAlignment="Left">
        <TextBlock Text="{i18n:StringLocalizer Text='Profile.Header'}" FontSize="24" FontWeight="Bold" Margin="0,0,0,4" />
        <TextBlock TextWrapping="Wrap" Margin="0,0,0,16" Foreground="Gray"
                   Text="{i18n:StringLocalizer Text='Profile.Description'}" />

        <TextBlock Text="{i18n:StringLocalizer Text='Profile.DisplayNameLabel'}" FontWeight="SemiBold" />
        <TextBox aqv:Valee.Field="{Binding DisplayName}" Margin="0,2,0,2" Padding="4" />
        <TextBlock Text="{Binding DisplayName.ErrorMessage, Converter={StaticResource LocalizeConverter}}" Foreground="Red" FontSize="11" Margin="0,0,0,8" />

        <TextBlock Text="{i18n:StringLocalizer Text='Profile.AgeLabel'}" FontWeight="SemiBold" />
        <TextBox aqv:Valee.Field="{Binding Age}" Margin="0,2,0,2" Padding="4" />
        <TextBlock Text="{Binding Age.ErrorMessage, Converter={StaticResource LocalizeConverter}}" Foreground="Red" FontSize="11" Margin="0,0,0,8" />

        <TextBlock Text="{i18n:StringLocalizer Text='Profile.BioLabel'}" FontWeight="SemiBold" />
        <TextBox aqv:Valee.Field="{Binding Bio}" Margin="0,2,0,2" Padding="4" AcceptsReturn="True" TextWrapping="Wrap" Height="60" />
        <TextBlock Text="{Binding Bio.ErrorMessage, Converter={StaticResource LocalizeConverter}}" Foreground="Red" FontSize="11" Margin="0,0,0,8" />

        <TextBlock Text="{i18n:StringLocalizer Text='Profile.WebsiteLabel'}" FontWeight="SemiBold" />
        <TextBox aqv:Valee.Field="{Binding Website}" Margin="0,2,0,2" Padding="4" />
        <TextBlock Text="{Binding Website.ErrorMessage, Converter={StaticResource LocalizeConverter}}" Foreground="Red" FontSize="11" Margin="0,0,0,8" />

        <Button Content="{i18n:StringLocalizer Text='Profile.Submit'}" Padding="12,6" HorizontalAlignment="Left" Margin="0,8,0,0"
                Command="{Binding SaveCommand}" />
        <TextBlock Text="{Binding StatusMessage}" Margin="0,16,0,0" FontWeight="SemiBold" Foreground="Green" TextWrapping="Wrap" />
    </StackPanel>
</UserControl>
