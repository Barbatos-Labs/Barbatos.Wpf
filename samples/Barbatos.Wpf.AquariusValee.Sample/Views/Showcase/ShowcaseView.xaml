<UserControl x:Class="Barbatos.Wpf.AquariusValee.Sample.Views.Showcase.ShowcaseView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             xmlns:local="clr-namespace:Barbatos.Wpf.AquariusValee.Sample.Views.Showcase"
             xmlns:aqv="http://schemas.barbatos.co/aquariusvalee/2026/xaml"
             xmlns:i18n="http://schemas.barbatos.co/i18n/2026/xaml"
             xmlns:app="clr-namespace:Barbatos.Wpf.AquariusValee.Sample">
    <UserControl.Resources>
        <aqv:FieldTemplateSelector x:Key="FieldTemplateSelector" />
        <aqv:SafeMessageConverter x:Key="LocalizeConverter">
            <i18n:LocalizeConverter />
        </aqv:SafeMessageConverter>
        <local:EmptyStringToVisibilityConverter x:Key="EmptyToVisibility" />

        <!--
            Every TextBox template below overlays [Display(Prompt)] as a real in-box watermark -
            a Grid stacks the TextBox and a gray, click-through TextBlock, with the TextBlock
            hidden the instant Value is non-empty (WPF's TextBox has no native placeholder support,
            unlike HTML's <input placeholder>). Label/Prompt/ErrorMessage are all runtime-bound
            strings (Field.Label is a "Field.*" key, not display text), so - unlike every other
            view's hand-typed XAML labels - they need LocalizeConverter to resolve them.
        -->

        <!-- Matches ShowcaseModel.Notes's [UIHint("MultilineText")]. -->
        <DataTemplate x:Key="MultilineText">
            <StackPanel Margin="0,0,0,10">
                <TextBlock Text="{Binding Label, Converter={StaticResource LocalizeConverter}}" FontWeight="SemiBold" Margin="0,0,0,2" />
                <Grid>
                    <TextBox aqv:Valee.Field="{Binding}" Padding="4" AcceptsReturn="True" TextWrapping="Wrap" Height="60" VerticalAlignment="Top" />
                    <TextBlock Text="{Binding Prompt, Converter={StaticResource LocalizeConverter}}"
                               Foreground="Gray" Margin="7,6,0,0" VerticalAlignment="Top" IsHitTestVisible="False"
                               Visibility="{Binding Value, Converter={StaticResource EmptyToVisibility}}" />
                </Grid>
                <TextBlock Text="{Binding ErrorMessage, Converter={StaticResource LocalizeConverter}}" Foreground="Red" FontSize="11" />
            </StackPanel>
        </DataTemplate>

        <!-- No UIHint on ShowcaseModel.CardNumber, but [CreditCard] is itself a DataTypeAttribute
             whose constructor sets DataType.CreditCard - do not also add an explicit
             [DataType(DataType.CreditCard)], it collides with [CreditCard] for any reflection
             that queries the DataTypeAttribute base type (AmbiguousMatchException at runtime,
             not a compile error). FieldTemplateSelector falls back to the DataTypeHint's enum
             name once UIHint is unset. Valee.Mask groups the digits in 4s as they are typed and
             inserts the spaces itself - every major card network uses fixed groups of 4, so one
             layout is safe here (unlike a phone number, below). -->
        <DataTemplate x:Key="CreditCard">
            <StackPanel Margin="0,0,0,10">
                <TextBlock Text="{Binding Label, Converter={StaticResource LocalizeConverter}}" FontWeight="SemiBold" Margin="0,0,0,2" />
                <Grid>
                    <TextBox aqv:Valee.Field="{Binding}" aqv:Valee.Mask="0000 0000 0000 0000" Padding="4" />
                    <TextBlock Text="{Binding Prompt, Converter={StaticResource LocalizeConverter}}"
                               Foreground="Gray" Margin="7,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                               Visibility="{Binding Value, Converter={StaticResource EmptyToVisibility}}" />
                </Grid>
                <TextBlock Text="{Binding ErrorMessage, Converter={StaticResource LocalizeConverter}}" Foreground="Red" FontSize="11" />
            </StackPanel>
        </DataTemplate>

        <!-- No explicit UIHint on ShowcaseModel.PhoneNumber either - [Phone] is also a
             DataTypeAttribute (DataType.PhoneNumber), so naming this key after that enum member
             is enough for FieldTemplateSelector to find it, same as CreditCard above.
             InputMask.Phone restricts typed/pasted input to phone-safe characters, but does not
             force one rigid layout - unlike a card number's fixed groups-of-4, phone formats vary
             too much across countries for a single mask to fit (see InputMask.cs's own remarks). -->
        <DataTemplate x:Key="PhoneNumber">
            <StackPanel Margin="0,0,0,10">
                <TextBlock Text="{Binding Label, Converter={StaticResource LocalizeConverter}}" FontWeight="SemiBold" Margin="0,0,0,2" />
                <Grid>
                    <TextBox aqv:Valee.Field="{Binding}" local:InputMask.Phone="True" Padding="4" />
                    <TextBlock Text="{Binding Prompt, Converter={StaticResource LocalizeConverter}}"
                               Foreground="Gray" Margin="7,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                               Visibility="{Binding Value, Converter={StaticResource EmptyToVisibility}}" />
                </Grid>
                <TextBlock Text="{Binding ErrorMessage, Converter={StaticResource LocalizeConverter}}" Foreground="Red" FontSize="11" />
            </StackPanel>
        </DataTemplate>

        <!-- ShowcaseModel.CountryCode's [UIHint("CountryCodeInput")] - needs an explicit UIHint
             since there's no DataType enum member for "2-letter country code" to fall back to.
             Valee.Mask ">AA" says it all: two letter slots, upper-cased as typed. No MaxLength
             needed either - a mask caps its own length. -->
        <DataTemplate x:Key="CountryCodeInput">
            <StackPanel Margin="0,0,0,10">
                <TextBlock Text="{Binding Label, Converter={StaticResource LocalizeConverter}}" FontWeight="SemiBold" Margin="0,0,0,2" />
                <Grid>
                    <TextBox aqv:Valee.Field="{Binding}" aqv:Valee.Mask="&gt;AA" Padding="4" />
                    <TextBlock Text="{Binding Prompt, Converter={StaticResource LocalizeConverter}}"
                               Foreground="Gray" Margin="7,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                               Visibility="{Binding Value, Converter={StaticResource EmptyToVisibility}}" />
                </Grid>
                <TextBlock Text="{Binding ErrorMessage, Converter={StaticResource LocalizeConverter}}" Foreground="Red" FontSize="11" />
            </StackPanel>
        </DataTemplate>

        <!-- ShowcaseModel.Sku's [UIHint("SkuInput")]. The mask and the [Pattern] attribute are two
             halves of one idea, and neither replaces the other: the mask shapes typing (it inserts
             the dash, upper-cases letters, and refuses a digit where a letter belongs), while
             [Pattern] is the actual verdict on submit. A regex cannot drive typing on its own -
             it is not positional, and checking the full pattern per keystroke would reject every
             prefix, so not one of "ABC-1234"'s eight characters could ever be entered. -->
        <DataTemplate x:Key="SkuInput">
            <StackPanel Margin="0,0,0,10">
                <TextBlock Text="{Binding Label, Converter={StaticResource LocalizeConverter}}" FontWeight="SemiBold" Margin="0,0,0,2" />
                <Grid>
                    <TextBox aqv:Valee.Field="{Binding}" aqv:Valee.Mask="&gt;AAA-0000" Padding="4" />
                    <TextBlock Text="{Binding Prompt, Converter={StaticResource LocalizeConverter}}"
                               Foreground="Gray" Margin="7,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                               Visibility="{Binding Value, Converter={StaticResource EmptyToVisibility}}" />
                </Grid>
                <TextBlock Text="{Binding ErrorMessage, Converter={StaticResource LocalizeConverter}}" Foreground="Red" FontSize="11" />
            </StackPanel>
        </DataTemplate>

        <!-- ShowcaseModel.Plan's [UIHint("PlanPicker")] - a genuinely different WIDGET (a
             dropdown), not just a resized TextBox, matching its closed EnumDataType constraint so
             picking from the list can't produce an invalid value in the first place. A ComboBox
             always shows its current selection (no "empty" state), so Prompt stays a plain line
             underneath rather than an in-box watermark. The three items are ShowcaseModel.Plan's
             own SubscriptionPlan member names - kept as fixed identifiers (like a wire-format enum
             value), not translated, since Valee.Field binds SelectedItem directly to the field's
             real string value. -->
        <DataTemplate x:Key="PlanPicker">
            <StackPanel Margin="0,0,0,10">
                <TextBlock Text="{Binding Label, Converter={StaticResource LocalizeConverter}}" FontWeight="SemiBold" />
                <TextBlock Text="{Binding Prompt, Converter={StaticResource LocalizeConverter}}" FontSize="11" Foreground="Gray" Margin="0,0,0,2" />
                <ComboBox aqv:Valee.Field="{Binding}" Padding="4">
                    <sys:String>Free</sys:String>
                    <sys:String>Pro</sys:String>
                    <sys:String>Enterprise</sys:String>
                </ComboBox>
                <TextBlock Text="{Binding ErrorMessage, Converter={StaticResource LocalizeConverter}}" Foreground="Red" FontSize="11" />
            </StackPanel>
        </DataTemplate>

        <!-- ShowcaseModel.Theme's [UIHint("ThemePicker")] - same reasoning as PlanPicker above,
             matching its AllowedValues constraint. -->
        <DataTemplate x:Key="ThemePicker">
            <StackPanel Margin="0,0,0,10">
                <TextBlock Text="{Binding Label, Converter={StaticResource LocalizeConverter}}" FontWeight="SemiBold" />
                <TextBlock Text="{Binding Prompt, Converter={StaticResource LocalizeConverter}}" FontSize="11" Foreground="Gray" Margin="0,0,0,2" />
                <ComboBox aqv:Valee.Field="{Binding}" Padding="4">
                    <sys:String>Light</sys:String>
                    <sys:String>Dark</sys:String>
                    <sys:String>System</sys:String>
                </ComboBox>
                <TextBlock Text="{Binding ErrorMessage, Converter={StaticResource LocalizeConverter}}" Foreground="Red" FontSize="11" />
            </StackPanel>
        </DataTemplate>

        <!-- MinPrice/MaxPrice/Price's [UIHint("NumberInput")]. Valee.Numeric filters typing down to
             digits, and snaps an out-of-range value back in once the field is left - never while
             typing, or entering "50" into a 10-100 field would rewrite the first "5" to "10". No
             Minimum/Maximum here: Price's own [PropertyRange] bounds are dynamic, and a field
             carrying [Range] hands its bounds over automatically (see the Profile tab's Age),
             so there is nothing to repeat in XAML. -->
        <DataTemplate x:Key="NumberInput">
            <StackPanel Margin="0,0,0,10">
                <TextBlock Text="{Binding Label, Converter={StaticResource LocalizeConverter}}" FontWeight="SemiBold" Margin="0,0,0,2" />
                <Grid>
                    <TextBox aqv:Valee.Field="{Binding}" aqv:Valee.Numeric="Integer" aqv:Valee.Minimum="0" Padding="4" />
                    <TextBlock Text="{Binding Prompt, Converter={StaticResource LocalizeConverter}}"
                               Foreground="Gray" Margin="7,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                               Visibility="{Binding Value, Converter={StaticResource EmptyToVisibility}}" />
                </Grid>
                <TextBlock Text="{Binding ErrorMessage, Converter={StaticResource LocalizeConverter}}" Foreground="Red" FontSize="11" />
            </StackPanel>
        </DataTemplate>

        <!-- Every other field (no UIHint, no DataTypeHint match) falls back to this. -->
        <DataTemplate x:Key="Default">
            <StackPanel Margin="0,0,0,10">
                <TextBlock Text="{Binding Label, Converter={StaticResource LocalizeConverter}}" FontWeight="SemiBold" Margin="0,0,0,2" />
                <Grid>
                    <TextBox aqv:Valee.Field="{Binding}" Padding="4" />
                    <TextBlock Text="{Binding Prompt, Converter={StaticResource LocalizeConverter}}"
                               Foreground="Gray" Margin="7,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                               Visibility="{Binding Value, Converter={StaticResource EmptyToVisibility}}" />
                </Grid>
                <TextBlock Text="{Binding ErrorMessage, Converter={StaticResource LocalizeConverter}}" Foreground="Red" FontSize="11" />
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel aqv:Valee.Form="{Binding ShowcaseForm}" Margin="24" MaxWidth="420" HorizontalAlignment="Left">
            <TextBlock Text="{app:SafeStringLocalizer Text='Showcase.Header'}" FontSize="22" FontWeight="Bold" Margin="0,0,0,4" />
            <TextBlock TextWrapping="Wrap" Margin="0,0,0,16" Foreground="Gray"
                       Text="{app:SafeStringLocalizer Text='Showcase.Description'}" />

            <ItemsControl ItemsSource="{Binding ShowcaseForm.Fields.Values}"
                          ItemTemplateSelector="{StaticResource FieldTemplateSelector}" />

            <!-- MinPrice/MaxPrice/Price (above) are the only fields on this page whose error
                 message is NOT translated when the language switches - see
                 PropertyRangeAttribute's own remarks for why a reflected attribute cannot call
                 ICompositeStringLocalizer the way every other field's ad-hoc/model rule can. -->
            <TextBlock Text="{app:SafeStringLocalizer Text='Showcase.PriceRangeNote'}" FontSize="11" FontStyle="Italic"
                       Foreground="Gray" TextWrapping="Wrap" Margin="0,4,0,0" />

            <Button Content="{app:SafeStringLocalizer Text='Showcase.Submit'}" Padding="12,6" HorizontalAlignment="Left" Margin="0,8,0,0"
                    Command="{Binding SubmitCommand}" />
            <TextBlock Text="{Binding StatusMessage}" Margin="0,16,0,0" FontWeight="SemiBold" Foreground="Green" TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
