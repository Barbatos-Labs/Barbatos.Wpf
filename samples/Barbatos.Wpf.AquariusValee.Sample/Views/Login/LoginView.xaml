<UserControl x:Class="Barbatos.Wpf.AquariusValee.Sample.Views.Login.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:aqv="http://schemas.barbatos.co/aquariusvalee/2026/xaml"
             xmlns:i18n="http://schemas.barbatos.co/i18n/2026/xaml">
    <UserControl.Resources>
        <i18n:LocalizeConverter x:Key="LocalizeConverter" />
    </UserControl.Resources>
    <StackPanel aqv:Valee.Form="{Binding LoginForm}" Margin="24" MaxWidth="360" HorizontalAlignment="Left">
        <TextBlock Text="{i18n:StringLocalizer Text='Login.Header'}" FontSize="24" FontWeight="Bold" Margin="0,0,0,4" />
        <TextBlock TextWrapping="Wrap" Margin="0,0,0,16" Foreground="Gray"
                   Text="{i18n:StringLocalizer Text='Login.Description'}" />

        <TextBlock Text="{i18n:StringLocalizer Text='Login.EmailLabel'}" FontWeight="SemiBold" />
        <TextBox aqv:Valee.Field="{Binding Email}" Margin="0,2,0,2" Padding="4" />
        <TextBlock Text="{Binding Email.ErrorMessage, Converter={StaticResource LocalizeConverter}}" Foreground="Red" FontSize="11" Margin="0,0,0,8" />

        <TextBlock Text="{i18n:StringLocalizer Text='Login.PasswordLabel'}" FontWeight="SemiBold" />
        <PasswordBox aqv:Valee.PasswordField="{Binding Password}" Margin="0,2,0,2" Padding="4" />
        <TextBlock Text="{Binding Password.ErrorMessage, Converter={StaticResource LocalizeConverter}}" Foreground="Red" FontSize="11" Margin="0,0,0,8" />

        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
            <Button Content="{i18n:StringLocalizer Text='Login.Submit'}" Padding="12,6" Command="{Binding LogInCommand}" />
            <TextBlock Text="{i18n:StringLocalizer Text='Login.Submitting'}" Margin="8,0,0,0" VerticalAlignment="Center" FontStyle="Italic"
                       Visibility="{Binding LoginForm.IsSubmitting, Converter={StaticResource BoolToVis}}" />
        </StackPanel>

        <TextBlock Text="{Binding StatusMessage}" Margin="0,16,0,0" FontWeight="SemiBold" Foreground="Green" TextWrapping="Wrap" />
    </StackPanel>
</UserControl>
